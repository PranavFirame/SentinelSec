# SentinelSec / AnalyticsPro Configuration

# Application
PROJECT_NAME="SentinelSec"
VERSION="1.0.0"
API_V1_STR="/api"

# Database (Default: SQLite persistent local file)
DATABASE_URL="sqlite:///./sentinelsec.db"

# Scanner Security & SSRF Safeguards
ALLOW_LOCAL_TARGETS=false
MAX_SCAN_TIMEOUT_SECONDS=30
DEFAULT_TIMEOUT_SECONDS=15
MAX_REDIRECTS=5
MAX_CONCURRENT_SCANS=4

# Advisory Feeds
OSV_API_URL="https://api.osv.dev/v1"
OSV_CACHE_TTL_SECONDS=3600
